# ABC Leilao Monitor - configuracoes locais
# Copie para .env e preencha seus dados. Nao envie .env para repositorios publicos.

# WhatsApp via CallMeBot
# 1. Salve +34 644 44 44 49 nos contatos
# 2. Envie: I allow callmebot to send me messages
# 3. Use a API Key recebida abaixo
WA_ATIVO=false
WA_NUMERO=+5511999999999
WA_APIKEY=SUA_APIKEY_AQUI

# E-mail via Gmail SMTP
# Use senha de app do Google, nao a senha normal da conta.
EMAIL_ATIVO=false
EMAIL_REMETENTE=seuemail@gmail.com
EMAIL_SENHA=xxxx xxxx xxxx xxxx
EMAIL_DEST=seuemail@gmail.com

# Filtros
LANCE_MIN=70000
LANCE_MAX=160000
QUARTOS_MIN=2

# Alertas v0.3
# ALERTAR_SOMENTE_NOVOS=true envia apenas oportunidades novas.
# ALERTAR_SCORE_MINIMO=60 ignora oportunidades abaixo do score definido.
# ALERTAR_MAX_ITENS=5 limita quantos itens entram no WhatsApp/e-mail.
ALERTAR_SOMENTE_NOVOS=false
ALERTAR_SCORE_MINIMO=0
ALERTAR_MAX_ITENS=5
