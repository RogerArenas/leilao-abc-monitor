# SP Leilões Monitor — variáveis de ambiente
# Copie para .env e preencha os valores

# ── Filtros de coleta ──────────────────────────────────────────────────────
LANCE_MIN=70000
LANCE_MAX=500000
QUARTOS_MIN=1

# Deixe vazio para coletar todo SP.
# Informe lista separada por vírgula para restringir:
# CIDADES=São Paulo,Campinas,Santos
CIDADES=

# ── Alertas WhatsApp (CallMeBot) ───────────────────────────────────────────
WA_ATIVO=true
WA_NUMERO=+5511999999999
WA_APIKEY=SUA_APIKEY_AQUI
# Cadastro gratuito: https://www.callmebot.com/blog/free-api-whatsapp-messages/

# ── Alertas por E-mail (Gmail Senha de App) ───────────────────────────────
EMAIL_ATIVO=true
EMAIL_REMETENTE=seuemail@gmail.com
EMAIL_SENHA=xxxx xxxx xxxx xxxx
EMAIL_DEST=seuemail@gmail.com

# ── Comportamento dos alertas ─────────────────────────────────────────────
ALERTAR_SOMENTE_NOVOS=true
ALERTAR_SCORE_MINIMO=0
ALERTAR_MAX_ITENS=5

# ── Serper.dev (Google Search API — 2500 buscas/mês grátis) ──────────────
# Cadastro: https://serper.dev
SERPER_API_KEY=
