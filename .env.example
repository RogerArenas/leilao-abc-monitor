# ================================================================
# ABC Leilões Monitor — Configuração
# Copie este arquivo para .env e preencha os valores
# ================================================================

# --- OBRIGATÓRIO: Chave da API Claude (busca via web_search) ---
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api...

# --- Filtros de busca ---
LANCE_MIN=70000
LANCE_MAX=160000
QUARTOS_MIN=2

# --- WhatsApp via CallMeBot (opcional) ---
# Siga as instruções em: https://www.callmebot.com/blog/free-api-whatsapp-messages/
WA_ATIVO=true
WA_NUMERO=+5511999999999
WA_APIKEY=SUA_APIKEY

# --- E-mail via Gmail (opcional) ---
# Use uma "Senha de App" de 16 dígitos (não a senha normal da conta)
# Ative em: https://myaccount.google.com/apppasswords
EMAIL_ATIVO=true
EMAIL_REMETENTE=seuemail@gmail.com
EMAIL_SENHA=xxxx xxxx xxxx xxxx
EMAIL_DEST=seuemail@gmail.com

# --- Alertas ---
ALERTAR_SOMENTE_NOVOS=true
ALERTAR_SCORE_MINIMO=0
ALERTAR_MAX_ITENS=5

# --- Serper.dev (Google Search API gratuita, 2500 buscas/mês) ---
# Cadastro grátis em https://serper.dev
SERPER_API_KEY=
