# ============================================================
#  ABC LEILÃO MONITOR — Configurações pessoais
#  Copie este arquivo como .env e preencha seus dados
#  NUNCA compartilhe este arquivo com ninguém
# ============================================================

# ── WhatsApp (CallMeBot — gratuito) ──────────────────────
# Passo 1: Salve o número +34 644 44 44 49 no seu WhatsApp
# Passo 2: Mande a mensagem: I allow callmebot to send me messages
# Passo 3: Você receberá sua API Key em resposta
# Passo 4: Preencha abaixo com seu número e a API Key recebida

WA_NUMERO=+5511999999999
WA_APIKEY=SUA_APIKEY_AQUI

# ── E-mail (Gmail) ───────────────────────────────────────
# Passo 1: Acesse myaccount.google.com > Segurança
# Passo 2: Ative a Verificação em duas etapas (obrigatório)
# Passo 3: Busque por "Senhas de app" e crie uma para "Email"
# Passo 4: Cole a senha de 16 caracteres abaixo (com os espaços)

EMAIL_REMETENTE=seuemail@gmail.com
EMAIL_SENHA=xxxx xxxx xxxx xxxx
EMAIL_DEST=seuemail@gmail.com
